# Solo se versionan las dos apps; el resto de esta carpeta (PDFs, notas, comparativas…) queda fuera
/*
!/.gitignore
!/Vocabulando/
!/Conjugario/
!/index.html

# basura de Windows y temporales de escritura
desktop.ini
Thumbs.db
*.tmp

# Los mazos de Vocabulando (un JSON por idioma, con tus palabras y repasos) son datos personales: viven en la carpeta que elige la app y no se suben
/Vocabulando/*.json

# dependencias de las pruebas (npm install)
node_modules/
